# Resend API key for sending emails
RESEND_API_KEY=

# Sender email address (format: "Display Name <email@domain>")
# Must be from a verified domain in your Resend account
RESEND_FROM_EMAIL="Workflow DevKit Birthday Demo <birthday-card-generator@platformatic.dev>"

# Vercel AI Gateway API key (get from Vercel dashboard → AI Gateway)
AI_GATEWAY_API_KEY=

# Public hostname for webhook callback URLs (e.g., RSVP links in emails).
# Without this, the SDK generates localhost URLs that are unreachable externally.
VERCEL_URL=birthday-card-generator.plt
